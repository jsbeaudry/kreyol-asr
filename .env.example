# cp .env.example .env  &&  fill in
# Needed to read your private datasets and to push the fine-tuned model.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# POD-ONLY paths. Leave these commented out on a laptop: /opt and /workspace
# do not exist there, and an unwritable HF_HOME makes every Hub download fail
# with a confusing "check your connection" error rather than a path error.
# scripts/pod_bootstrap.sh sets both on the pod, so you rarely need them here.
# ---------------------------------------------------------------------------

# Where the NeMo git checkout lives (the pip package omits examples/).
# NEMO_DIR=/opt/NeMo

# Keep the HF cache on the pod's fast volume, not the small root disk.
# HF_HOME=/workspace/.hf
